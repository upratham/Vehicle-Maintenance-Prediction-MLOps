# Copy to .env and fill in real values.

# MongoDB
CONNECTION_URL=mongodb+srv://<user>:<pass>@cluster.mongodb.net/
DB_USERNAME=605_Project_Data
DB_PASSWORD=
COLLECTION_NAME=vehicle_maintenance_data

# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=
ECR_REPO=vehicleproj
ECR_URL=

# ClearML — get from https://app.clear.ml -> Settings -> Workspace -> Create credentials
CLEARML_API_HOST=https://api.clear.ml
CLEARML_WEB_HOST=https://app.clear.ml
CLEARML_FILES_HOST=https://files.clear.ml
CLEARML_API_ACCESS_KEY=
CLEARML_API_SECRET_KEY=

# Retrain endpoint auth (leave empty to allow unauthenticated /train)
OPS_TOKEN=
